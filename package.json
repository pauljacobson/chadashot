{
  "name": "chadashot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "benchmark:dev": "PERFORMANCE_FIXTURE=1 DATA_DIR=./data/performance PORT=8788 API_PORT=8788 npm run dev",
    "benchmark:reader-api": "tsx server/reader-api-benchmark.ts",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server-dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-virtual": "^3.14.11",
    "better-sqlite3": "13.0.3",
    "compression": "^1.8.1",
    "dompurify": "3.4.15",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.2.0",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "25.9.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "7.2.0",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "fake-indexeddb": "6.2.5",
    "globals": "17.3.0",
    "jsdom": "29.0.0",
    "railway": "3.11.0",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-window": "7.4.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}

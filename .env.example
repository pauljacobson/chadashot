# Local development only. Production must use AUTH_MODE=passkey.
NODE_ENV=development
AUTH_MODE=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data

# Required before connecting Birchfeed or Readwise. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=

# Used only for the first production account setup. Generate a long random value,
# add it to Railway, and remove it from Railway after setup succeeds.
BOOTSTRAP_TOKEN=

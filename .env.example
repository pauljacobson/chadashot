# Local development only. Production must use AUTH_MODE=passkey.
NODE_ENV=development
AUTH_MODE=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data

# Required before connecting Birchfeed or Readwise. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=

# Used only for the first production account setup. Generate a long random value,
# add it to Railway, and remove it from Railway after setup succeeds.
BOOTSTRAP_TOKEN=

# Structured application logs are written to the console and to DATA_DIR/logs.
# LOG_LEVEL can be debug, info, warn, or error. The file is kept to a bounded size.
LOG_LEVEL=info
LOG_OUTPUT=both
LOG_MAX_BYTES=5242880

# Bound a complete Reader provider traversal so a hanging upstream request
# cannot retain synchronization ownership indefinitely.
READER_SYNC_TIMEOUT_MS=120000

# Browser reader path. Set to snapshot for a compatibility rollback; pair with
# READER_CACHE_ENABLED=false only when the provider-direct server path is needed.
READER_CLIENT_PATH=paginated

# Durable server cache is enabled by default. Set false only as a temporary
# rollback to the legacy request-blocking reader path; migrations remain applied.
READER_CACHE_ENABLED=true

# Delete at most one unprotected obsolete generation after each full-import
# outcome and during startup recovery. Disable only as an operational rollback;
# use the dry-run operator command before manual backlog cleanup.
READER_CACHE_AUTO_PRUNE=true

# SQLite-backed import lease. The web process heartbeats every one-third of this
# duration so an expired owner can be fenced and recovered after a restart.
READER_SYNC_LEASE_MS=45000

# Incremental reader synchronization cadence. Routine discovery fetches bodies
# only for unknown IDs; broader state/body/full reconciliation is less frequent.
READER_ROUTINE_SYNC_INTERVAL_MS=180000
READER_STATE_SYNC_INTERVAL_MS=900000
READER_BODY_SYNC_INTERVAL_MS=21600000
READER_FULL_SYNC_INTERVAL_MS=86400000
READER_SYNC_OVERLAP_SECONDS=21600

# Local development only. Production must use AUTH_MODE=passkey.
NODE_ENV=development
AUTH_MODE=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data

# Required before connecting Birchfeed or Readwise. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=

# Used only for the first production account setup. Generate a long random value,
# add it to Railway, and remove it from Railway after setup succeeds.
BOOTSTRAP_TOKEN=

# Structured application logs are written to the console and to DATA_DIR/logs.
# LOG_LEVEL can be debug, info, warn, or error. The file is kept to a bounded size.
LOG_LEVEL=info
LOG_OUTPUT=both
LOG_MAX_BYTES=5242880

# Bound a complete Reader provider traversal so a hanging upstream request
# cannot retain synchronization ownership indefinitely.
READER_SYNC_TIMEOUT_MS=120000

# Durable server cache is enabled by default. Set false only as a temporary
# rollback to the legacy request-blocking reader path; migrations remain applied.
READER_CACHE_ENABLED=true

# SQLite-backed import lease. The web process heartbeats every one-third of this
# duration so an expired owner can be fenced and recovered after a restart.
READER_SYNC_LEASE_MS=45000

# Avoid starting another full provider import for every compatibility snapshot
# request. Incremental refresh scheduling replaces this in issue #6.
READER_CACHE_REFRESH_INTERVAL_MS=180000

# Production-only offsite replication. Configure these in Railway, not in this
# file. The R2 endpoint belongs in the replica URL without an https:// prefix.
# LITESTREAM_REPLICA_URL=s3://BUCKET/chadashot?endpoint=ACCOUNT_ID.r2.cloudflarestorage.com&region=auto
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
